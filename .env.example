# Copiar a .env.local y completar con las claves del proyecto Supabase.
# Las siguientes cadenas son marcadores; no son credenciales funcionales.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Solo servidor. No usar un prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SECRET_KEY=your-server-secret-key

# Transporte. MESSAGE_PROVIDER es el selector nuevo; vacío conserva exactamente
# el selector histórico WHATSAPP_PROVIDER. Valores: mock|twilio|meta|smsgate.
MESSAGE_PROVIDER=
WHATSAPP_PROVIDER=mock
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Admite con o sin el prefijo "whatsapp:"; el adaptador lo normaliza.
TWILIO_WHATSAPP_FROM=+15550001234
# B5 — Content SIDs de las plantillas aprobadas (Twilio Content API), una
# por forma de mensaje. Cada una vacía = ese tipo sigue solo pudiendo
# mandarse dentro de la ventana de sesión de 24h (falla explícito con
# template_not_configured fuera de ella). Texto exacto enviado a revisión
# en docs/bitacora-canal-b.md 2026-09-08 (B5).
TWILIO_MEDICATION_CONTENT_SID=
TWILIO_MEASUREMENT_GLUCOSE_CONTENT_SID=
TWILIO_MEASUREMENT_BP_CONTENT_SID=
TWILIO_APPOINTMENT_CONTENT_SID=
TWILIO_NONRESPONSE_CONTENT_SID=

# SMS celular mediante https://github.com/capcom6/android-sms-gateway
# La base termina antes de /messages. Ejemplo Cloud:
# https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_BASE_URL=
# Recomendado: JWT con alcance messages:send. Si está vacío, se usa Basic Auth.
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Opcionales: fijar Android/SIM; vacíos dejan que SMSGate elija sus defaults.
SMS_GATEWAY_DEVICE_ID=
SMS_GATEWAY_SIM_NUMBER=
SMS_GATEWAY_TTL_SECONDS=3600
SMS_GATEWAY_TIMEOUT_MS=10000
# URL pública exacta SIN "/" final — debe ser igual a la configurada en el
# panel de Twilio para el webhook; se usa para validar X-Twilio-Signature.
APP_PUBLIC_URL=https://your-public-domain.example.com

# Token Bearer que protege `api/jobs/tick` (mínimo 16 caracteres). Sin
# valor, ese endpoint rechaza toda request: nunca "sin token = público".
CRON_SECRET=

# Modelo predictivo (RF29/RF30) — microservicio del equipo de IA.
# URL COMPLETA del endpoint, con la ruta incluida. Vacío = inferencia
# deshabilitada: el tablero sigue operando solo con evaluateRisk(). Nunca
# usar NEXT_PUBLIC_ aquí; el navegador no habla con el modelo.
ML_ENDPOINT_URL=
# Se manda en el header X-API-Key (es el que valida app.py del servicio).
ML_API_KEY=
# Milisegundos de espera por paciente. Una predicción nunca debe retrasar
# la carga del tablero.
ML_TIMEOUT_MS=2000

# El Cron que llama a `api/jobs/tick` todavía requiere su integración del
# plan. No habilitar envíos ni inferencia solo por agregar variables aquí.
