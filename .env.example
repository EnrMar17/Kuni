# Copiar a .env.local y completar con las claves del proyecto Supabase.
# Las siguientes cadenas son marcadores; no son credenciales funcionales.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Solo servidor. No usar un prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SECRET_KEY=your-server-secret-key

# WhatsApp, Cron y ML todavía requieren sus integraciones del plan.
# No habilitar envíos ni inferencia solo por agregar variables aquí.
