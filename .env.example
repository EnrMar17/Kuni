# Copiar a .env.local y completar con las claves del proyecto Supabase.
# Las siguientes cadenas son marcadores; no son credenciales funcionales.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Solo servidor. No usar un prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SECRET_KEY=your-server-secret-key

# WhatsApp. "mock" es el default seguro: no envía nada real y persiste como
# provider='demo'. Cambiar a "twilio" solo con las credenciales de abajo listas.
WHATSAPP_PROVIDER=mock
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Admite con o sin el prefijo "whatsapp:"; el adaptador lo normaliza.
TWILIO_WHATSAPP_FROM=+15550001234
# Content SID de la plantilla aprobada para recordatorio de cita (Twilio Content API).
TWILIO_APPOINTMENT_CONTENT_SID=
# URL pública exacta SIN "/" final — debe ser igual a la configurada en el
# panel de Twilio para el webhook; se usa para validar X-Twilio-Signature.
APP_PUBLIC_URL=https://your-public-domain.example.com

# Cron y ML todavía requieren sus integraciones del plan.
# No habilitar envíos ni inferencia solo por agregar variables aquí.
